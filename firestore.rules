rules_version = '2';

// Kith security rules.
//
// Everything a household owns lives under households/{hid}, readable and
// writable only by that household's members. The single top-level collection
// is inviteCodes, a code -> household id index that exists so a prospective
// member can find the household they were invited to before they are allowed
// to read anything inside it. See docs/M1-FIRESTORE-RULES.md for the reasoning,
// including why the index is a lookup convenience and not a security boundary.
//
// There is no wildcard match at the bottom: anything not named here is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers ---------------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function memberDoc(hid) {
      return get(/databases/$(database)/documents/households/$(hid)/members/$(request.auth.uid));
    }

    function isMember(hid) {
      return signedIn() &&
        exists(/databases/$(database)/documents/households/$(hid)/members/$(request.auth.uid));
    }

    function isOwner(hid) {
      return isMember(hid) && memberDoc(hid).data.role == 'owner';
    }

    function householdDoc(hid) {
      return get(/databases/$(database)/documents/households/$(hid));
    }

    function indexDoc(code) {
      return get(/databases/$(database)/documents/inviteCodes/$(code));
    }

    // Epoch milliseconds, as written by every model's toMap(). Bounded so a
    // client cannot store a value that overflows date maths downstream.
    function isEpochMillis(value) {
      return value is int && value > 0 && value < 4102444800000;
    }

    function isBoundedString(value, maxLength) {
      return value is string && value.size() > 0 && value.size() <= maxLength;
    }

    // An optional field: absent, explicitly null, or a bounded string. The
    // models write null rather than omitting the key, and read a missing key
    // as null, so both spellings have to pass.
    function isOptionalString(data, field, maxLength) {
      return !(field in data) || data[field] == null ||
        isBoundedString(data[field], maxLength);
    }

    // Crockford Base32 without I, L, O or U, six characters. Mirrors
    // InviteCode.alphabet in lib/features/household/domain/invite_code.dart.
    function isInviteCode(value) {
      return value is string && value.matches('^[0-9A-HJKMNP-TV-Z]{6}$');
    }

    // The caller owns the index entry for `code`, and it points at `hid`.
    // A forged entry someone else created fails the createdBy check.
    function ownsIndexEntryFor(code, hid) {
      return exists(/databases/$(database)/documents/inviteCodes/$(code)) &&
        indexDoc(code).data.householdId == hid &&
        indexDoc(code).data.createdBy == request.auth.uid;
    }

    function unchanged(field) {
      return !(field in request.resource.data) ||
        request.resource.data[field] == resource.data[field];
    }

    // ---- households/{hid} ------------------------------------------------

    // calendarId and calendarName are optional and absent on every household
    // written before M5, so they are allowed but never required.
    function isValidHousehold(hid, data) {
      return data.keys().hasOnly(['id', 'name', 'inviteCode', 'createdAt', 'createdBy',
          'calendarId', 'calendarName']) &&
        data.keys().hasAll(['id', 'name', 'inviteCode', 'createdAt', 'createdBy']) &&
        data.id == hid &&
        isBoundedString(data.name, 100) &&
        isInviteCode(data.inviteCode) &&
        isEpochMillis(data.createdAt) &&
        data.createdBy is string &&
        isOptionalString(data, 'calendarId', 1024) &&
        isOptionalString(data, 'calendarName', 200);
    }

    match /households/{hid} {
      allow read: if isMember(hid);

      // Write order is index entry, then household, then the owner's member
      // document. The index entry has to exist first so this rule can confirm
      // the creator reserved the code they are claiming.
      allow create: if signedIn() &&
        isValidHousehold(hid, request.resource.data) &&
        request.resource.data.createdBy == request.auth.uid &&
        ownsIndexEntryFor(request.resource.data.inviteCode, hid);

      // Two updates, with different gates.
      //
      // Owners may rename the household and rotate its invite code. Rotating
      // requires having reserved the new code first, so an owner cannot point
      // their household at an index entry somebody else created.
      //
      // Any member may link or unlink the household calendar. The calendar the
      // frame reads is household property rather than the owner's, the OAuth
      // grant behind the pick is the linking member's own, and a household
      // whose owner is asleep should not be stuck without one. The two branches
      // are exclusive on affectedKeys, so neither can be used to make the
      // other's change.
      allow update: if isValidHousehold(hid, request.resource.data) &&
        unchanged('id') &&
        unchanged('createdAt') &&
        unchanged('createdBy') &&
        (
          (isOwner(hid) &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['name', 'inviteCode']) &&
            (request.resource.data.inviteCode == resource.data.inviteCode ||
              ownsIndexEntryFor(request.resource.data.inviteCode, hid))) ||
          (isMember(hid) &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['calendarId', 'calendarName']))
        );

      // No household deletion in v1. Removing one means cascading every
      // subcollection, which a client cannot do atomically.
      allow delete: if false;

      // ---- households/{hid}/members/{uid} --------------------------------

      // digestDay and digestHour are the member's own weekly-digest
      // preference. Optional and absent on every member written before M6, so
      // they are allowed but never required. digestDay is a Dart weekday,
      // Monday being 1, or null for no digest at all.
      function isOptionalDigest(data) {
        return (!('digestDay' in data) || data.digestDay == null ||
            (data.digestDay is int && data.digestDay >= 1 && data.digestDay <= 7)) &&
          (!('digestHour' in data) || data.digestHour == null ||
            (data.digestHour is int && data.digestHour >= 0 && data.digestHour <= 23));
      }

      function isValidMember(uid, data, extraKeys) {
        return data.keys().hasOnly(
            ['id', 'displayName', 'email', 'role', 'joinedAt', 'photoUrl',
             'digestDay', 'digestHour'].concat(extraKeys)) &&
          data.keys().hasAll(
            ['id', 'displayName', 'email', 'role', 'joinedAt', 'photoUrl'].concat(extraKeys)) &&
          data.id == uid &&
          isBoundedString(data.displayName, 100) &&
          isBoundedString(data.email, 320) &&
          data.role in ['owner', 'member'] &&
          isEpochMillis(data.joinedAt) &&
          (data.photoUrl == null || isBoundedString(data.photoUrl, 2048)) &&
          isOptionalDigest(data);
      }

      match /members/{uid} {
        allow read: if isMember(hid);

        // Two ways in, both self-writes only.
        //
        // Owner: the household names you as its creator. Nobody else can take
        // that role, because createdBy is immutable once the household exists.
        //
        // Joiner: you prove knowledge of the current invite code by echoing it
        // back in joinedWithCode, a write-time token the Member model ignores.
        // role must be 'member' on this path, which is what stops a joiner
        // escalating to owner.
        allow create: if isSelf(uid) && (
          (isValidMember(uid, request.resource.data, []) &&
            request.resource.data.role == 'owner' &&
            householdDoc(hid).data.createdBy == request.auth.uid) ||
          (isValidMember(uid, request.resource.data, ['joinedWithCode']) &&
            request.resource.data.role == 'member' &&
            request.resource.data.joinedWithCode == householdDoc(hid).data.inviteCode)
        );

        // Self-updates cover profile fields only; role is deliberately absent,
        // so a member cannot promote themselves and an owner cannot be demoted
        // by anyone but another owner.
        allow update: if isValidMember(uid, request.resource.data, []) &&
          unchanged('id') &&
          unchanged('joinedAt') &&
          (
            (isSelf(uid) && isMember(hid) &&
              request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['displayName', 'email', 'photoUrl',
                          'digestDay', 'digestHour'])) ||
            (isOwner(hid) &&
              request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['role']))
          );

        // Leaving is a self-delete; removing someone else takes an owner.
        allow delete: if (isSelf(uid) && isMember(hid)) || isOwner(hid);
      }

      // ---- households/{hid}/contacts/{cid} --------------------------------
      //
      // Any member may write any contact: there is no per-member ownership
      // inside a household, and the point of the app is that both adults edit
      // the same list. What is checked is the shape, which mirrors the bounds
      // in lib/data/models/contact.dart and the validation the repository
      // runs before the round trip.

      // A birthday, in the two spellings Birthday.wireValue writes:
      // '1988-03-14' with a year, '--03-14' without one. Optional and absent
      // on every contact written before M6, so it is allowed but never
      // required. The shape is checked here; whether the day exists in the
      // month is the model's job, since rules have no calendar.
      function isOptionalBirthday(data) {
        return !('birthday' in data) || data.birthday == null ||
          (data.birthday is string &&
            data.birthday.matches('^([0-9]{4}|-)-[0-9]{2}-[0-9]{2}$'));
      }

      function isValidContact(cid, data) {
        return data.keys().hasOnly(['id', 'name', 'relationshipTypeId', 'cadenceDays',
            'priority', 'createdAt', 'updatedAt', 'phone', 'email', 'address',
            'guardianName', 'guardianPhone', 'birthday', 'notes', 'tags', 'isArchived']) &&
          data.keys().hasAll(['id', 'name', 'relationshipTypeId', 'cadenceDays',
            'priority', 'createdAt', 'updatedAt', 'tags', 'isArchived']) &&
          data.id == cid &&
          isBoundedString(data.name, 100) &&
          isBoundedString(data.relationshipTypeId, 128) &&
          data.cadenceDays is int &&
          data.cadenceDays >= 1 && data.cadenceDays <= 3650 &&
          data.priority in ['low', 'normal', 'high'] &&
          isEpochMillis(data.createdAt) &&
          isEpochMillis(data.updatedAt) &&
          isOptionalString(data, 'phone', 200) &&
          isOptionalString(data, 'email', 200) &&
          isOptionalString(data, 'address', 200) &&
          isOptionalString(data, 'guardianName', 200) &&
          isOptionalString(data, 'guardianPhone', 200) &&
          isOptionalBirthday(data) &&
          isOptionalString(data, 'notes', 2000) &&
          data.tags is list && data.tags.size() <= 20 &&
          data.isArchived is bool;
      }

      match /contacts/{cid} {
        allow read: if isMember(hid);

        allow create: if isMember(hid) && isValidContact(cid, request.resource.data);

        // The editor sends a partial update that leaves id, createdAt and
        // isArchived alone; archiving sends isArchived and updatedAt only.
        // Both land here, so the merged document is what gets validated and
        // the two immutable fields are pinned separately.
        allow update: if isMember(hid) &&
          isValidContact(cid, request.resource.data) &&
          unchanged('id') &&
          unchanged('createdAt');

        // No hard delete: archiving is the removal the app offers, so that a
        // contact's hangout history is never orphaned. See ContactRepository.
        allow delete: if false;
      }

      // ---- households/{hid}/relationshipTypes/{rid} -----------------------
      //
      // Deleting a label reassigns the contacts filed under it in the same
      // batch, which is why a member may both delete a label and update
      // contacts: the two rules together are what make reassignment possible
      // client-side. Nothing here can check that the batch is well formed --
      // that guarantee is the repository's, not the rules'.

      function isValidRelationshipType(rid, data) {
        return data.keys().hasOnly(['id', 'name', 'sortOrder', 'createdAt']) &&
          data.keys().hasAll(['id', 'name', 'sortOrder', 'createdAt']) &&
          data.id == rid &&
          isBoundedString(data.name, 60) &&
          data.sortOrder is int &&
          data.sortOrder >= 0 && data.sortOrder <= 1000 &&
          isEpochMillis(data.createdAt);
      }

      match /relationshipTypes/{rid} {
        allow read: if isMember(hid);

        allow create: if isMember(hid) &&
          isValidRelationshipType(rid, request.resource.data);

        // Renaming sends `name` alone and reordering sends `sortOrder` alone,
        // so both arrive as partial updates over an existing document.
        allow update: if isMember(hid) &&
          isValidRelationshipType(rid, request.resource.data) &&
          unchanged('id') &&
          unchanged('createdAt');

        allow delete: if isMember(hid);
      }

      // ---- households/{hid}/hangouts/{hgid} -------------------------------
      //
      // A logged meetup. Any member may log, edit or remove one: the point of
      // the app is that both adults keep the same record, and a hangout one
      // partner logged against the wrong person is the other partner's to fix.
      //
      // What is pinned is authorship. createdBy must be the caller on create
      // and cannot move afterwards, so an edit can change the date, the note
      // and who was there, but never who logged it.

      function isValidHangout(hgid, data) {
        return data.keys().hasOnly(['id', 'occurredOn', 'contactIds', 'attendeeIds',
            'createdBy', 'createdAt', 'updatedAt', 'note']) &&
          data.keys().hasAll(['id', 'occurredOn', 'contactIds', 'attendeeIds',
            'createdBy', 'createdAt', 'updatedAt']) &&
          data.id == hgid &&
          isEpochMillis(data.occurredOn) &&
          data.contactIds is list &&
          data.contactIds.size() > 0 && data.contactIds.size() <= 50 &&
          data.attendeeIds is list && data.attendeeIds.size() <= 20 &&
          data.createdBy is string &&
          isEpochMillis(data.createdAt) &&
          isEpochMillis(data.updatedAt) &&
          isOptionalString(data, 'note', 2000);
      }

      match /hangouts/{hgid} {
        allow read: if isMember(hid);

        allow create: if isMember(hid) &&
          isValidHangout(hgid, request.resource.data) &&
          request.resource.data.createdBy == request.auth.uid;

        // The form sends a partial update that leaves id, createdBy and
        // createdAt alone, so the merged document is what gets validated and
        // the three immutable fields are pinned separately.
        allow update: if isMember(hid) &&
          isValidHangout(hgid, request.resource.data) &&
          unchanged('id') &&
          unchanged('createdBy') &&
          unchanged('createdAt');

        // Hangouts do delete, unlike contacts: a mislogged meetup is an error
        // in the record rather than history, and nothing hangs off one.
        allow delete: if isMember(hid);
      }

      // ---- households/{hid}/plannedHangouts/{pid} -------------------------
      //
      // An intent about a meetup still to come: an arrangement, or a "not now"
      // that defers a suggestion. Any member may make, keep or drop one, for
      // the same reason they may log a hangout: the Reconnect section is a
      // shared prompt, and either partner acting on it is the point.
      //
      // Authorship is pinned the way a hangout's is: createdBy must be the
      // caller on create and cannot move afterwards. calendarEventId is
      // written when a plan is confirmed onto the household's calendar, and
      // cleared when its event goes; either member may do both, because the
      // calendar is shared and so is the plan.

      function isValidPlannedHangout(pid, data) {
        return data.keys().hasOnly(['id', 'plannedFor', 'contactIds', 'status',
            'createdBy', 'createdAt', 'updatedAt', 'note', 'calendarEventId']) &&
          data.keys().hasAll(['id', 'plannedFor', 'contactIds', 'status',
            'createdBy', 'createdAt', 'updatedAt']) &&
          data.id == pid &&
          isEpochMillis(data.plannedFor) &&
          data.contactIds is list &&
          data.contactIds.size() > 0 && data.contactIds.size() <= 50 &&
          data.status in ['proposed', 'confirmed', 'snoozed'] &&
          data.createdBy is string &&
          isEpochMillis(data.createdAt) &&
          isEpochMillis(data.updatedAt) &&
          isOptionalString(data, 'note', 2000) &&
          isOptionalString(data, 'calendarEventId', 1024);
      }

      match /plannedHangouts/{pid} {
        allow read: if isMember(hid);

        allow create: if isMember(hid) &&
          isValidPlannedHangout(pid, request.resource.data) &&
          request.resource.data.createdBy == request.auth.uid;

        // Confirming a plan onto the calendar, following an event that was
        // moved, and dropping the link when the event goes are all updates
        // over an existing document, so the merged document is what gets
        // validated and the three immutable fields are pinned separately.
        allow update: if isMember(hid) &&
          isValidPlannedHangout(pid, request.resource.data) &&
          unchanged('id') &&
          unchanged('createdBy') &&
          unchanged('createdAt');

        // Plans do delete, like hangouts: an arrangement that is off, or a
        // deferral somebody undid, is not history worth keeping.
        allow delete: if isMember(hid);
      }
    }

    // ---- membership lookup across households -----------------------------
    //
    // A returning user has to find their household before they are allowed to
    // read anything inside it, and their membership document is the only
    // record that they belong to one. This collection group match is what lets
    // them query for their own membership documents wherever those live.
    //
    // Rules are not filters, so this only passes for a query whose constraints
    // guarantee it: the caller must send where('id', '==', their own uid),
    // which is exactly what watchHouseholdIdsFor sends. It grants no document
    // the caller could not already read -- the results are their own
    // membership records, in households they are a member of by definition.
    //
    // Note the breadth: {path=**} matches any collection named `members`
    // anywhere in the database, so a future `members` collection somewhere
    // else inherits this rule.

    match /{path=**}/members/{uid} {
      allow read: if signedIn() && request.auth.uid == resource.data.id;
    }

    // ---- inviteCodes/{code} ----------------------------------------------
    //
    // A code -> household id pointer, holding no user data. The document id is
    // the code itself, so reading one means already knowing it; listing the
    // collection is denied, which is what keeps codes unguessable in practice.
    //
    // Anyone signed in can create an entry, including one pointing at a
    // household they do not own. That is harmless: the household create rule
    // and the member create rule both re-check against the household document
    // itself, so a forged pointer grants nothing.

    match /inviteCodes/{code} {
      function isValidIndexEntry(code, data) {
        return data.keys().hasOnly(['householdId', 'createdBy', 'createdAt']) &&
          data.keys().hasAll(['householdId', 'createdBy', 'createdAt']) &&
          isInviteCode(code) &&
          isBoundedString(data.householdId, 128) &&
          data.createdBy is string &&
          isEpochMillis(data.createdAt);
      }

      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn() &&
        isValidIndexEntry(code, request.resource.data) &&
        request.resource.data.createdBy == request.auth.uid;

      // Rotation is create-the-new-one then delete-the-old-one, so that a
      // half-finished rotation leaves a stale pointer rather than a code that
      // resolves to the wrong household.
      allow update: if false;

      allow delete: if isOwner(resource.data.householdId);
    }
  }
}
